# Converge editors before formatters even run.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Biome formats TS/JS at 2 spaces; keep editors in agreement.
[*.{ts,tsx,js,mjs,cjs,json,jsonc}]
indent_size = 2

[*.{yml,yaml,toml}]
indent_size = 2

[*.sh]
indent_style = tab

# Markdown uses trailing whitespace as a hard line break.
[*.md]
trim_trailing_whitespace = false
