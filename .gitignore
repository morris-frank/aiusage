# Secrets — never committed. Documented in .env.example, auto-loaded by mise.
.env
.env.local
# Per-machine mise overrides; may carry credentials in [env].
mise.local.toml

# Node
node_modules/
dist/
*.tsbuildinfo

# Tool caches
.mise/
.cache/
coverage/
.vitest/
.pnpm-store/

# aiusage's own on-disk pricing cache (see src/pricing/cache.ts)
.aiusage-cache/

# Report figures. `aiusage report` writes here when AIUSAGE_REPORT_DIR is unset,
# so running the tool on its own repo must not dirty the tree.
*-aiusage-report-*.html
*-aiusage-report-*.svg

# macOS
.DS_Store
