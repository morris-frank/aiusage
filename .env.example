# aiusage credentials. Copy to `.env` (gitignored, auto-loaded by mise) and fill
# in only the platforms you want to report on — every provider is skipped, not
# failed, when its credentials are absent.
#
# All keys are read straight from process.env. There is no config framework.

# ─── OpenRouter ───────────────────────────────────────────────────────────────
# Usage comes from GET /api/v1/activity (last 30 completed UTC days).
# A plain inference key reports that key's own activity. A *management* key
# (openrouter.ai/settings/provisioning-keys) is required to enumerate keys and
# split usage per API key and per org member.
#
# Both variables accept SEVERAL keys, because a management key is scoped to one
# workspace: suffix the name per workspace (the suffix becomes the workspace's
# label in reports), and/or pass a comma-separated list. aiusage asks
# GET /api/v1/key what each key actually is, so a management key pasted into
# OPENROUTER_API_KEY still gets used as one — with a notice.
OPENROUTER_API_KEY=
# Optional: management/provisioning key. If set, aiusage lists /api/v1/keys and
# fans out /api/v1/activity per key hash. OPENROUTER_PROVISIONING_KEY works too.
OPENROUTER_MANAGEMENT_KEY=
# One per workspace, e.g.:
# OPENROUTER_MANAGEMENT_KEY_ACME=
# OPENROUTER_MANAGEMENT_KEY_LABS=

# ─── OpenAI Platform ──────────────────────────────────────────────────────────
# Requires an *admin* key (platform.openai.com/settings/organization/admin-keys).
# Normal project keys cannot read /v1/organization/usage/* or /costs.
OPENAI_ADMIN_KEY=
# Optional: restrict to one org (only needed for multi-org admin keys).
OPENAI_ORG_ID=

# ─── Anthropic (Claude) Platform ──────────────────────────────────────────────
# Requires an Admin API key (`sk-ant-admin...`) from Console → Settings → Admin
# keys. Normal API keys get 401 on /v1/organizations/*.
ANTHROPIC_ADMIN_KEY=

# ─── Together AI ──────────────────────────────────────────────────────────────
# Together exposes no public usage or cost API (cost analytics are dashboard
# only, as of 2026-07). The key is used for identity (/v1/whoami) and live
# per-model pricing (/v1/models); `aiusage` reports usage for Together as
# unsupported rather than guessing. See README → Capability matrix.
TOGETHER_API_KEY=

# ─── Local agents (ccusage) ───────────────────────────────────────────────────
# `aiusage --local` also runs ccusage and fuses local agent usage (Claude Code,
# Codex, …) into the same report. No credential: ccusage reads local logs. By
# default aiusage runs `ccusage` from PATH, else `npx --yes ccusage@latest`.
# Override the invocation (an argv, not a shell line):
# AIUSAGE_CCUSAGE_CMD=bunx ccusage@latest

# ─── Behaviour ────────────────────────────────────────────────────────────────
# Where the offline pricing cache lives (default: ~/.cache/aiusage).
# AIUSAGE_CACHE_DIR=
# Per-request timeout in milliseconds (default: 30000).
# AIUSAGE_TIMEOUT_MS=
# Max concurrent HTTP requests per provider (default: 4).
# AIUSAGE_CONCURRENCY=
